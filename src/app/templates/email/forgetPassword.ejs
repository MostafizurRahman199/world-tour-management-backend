<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Password Reset</title>
    <style>
      body {
        font-family: 'Helvetica Neue', Arial, sans-serif;
        color: #333;
        background: #f4f7fa;
        margin: 0;
        padding: 0;
      }

      .container {
        max-width: 600px;
        margin: 40px auto;
        padding: 0 15px;
      }

      .card {
        background: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        border: 1px solid #e2e8f0;
      }

      h2 {
        color: #1e293b;
        font-size: 24px;
        margin-bottom: 16px;
      }

      p {
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 16px;
      }

      .btn {
        display: inline-block;
        padding: 12px 20px;
        background: linear-gradient(90deg, #16a34a, #22c55e); /* green gradient */
        color: #ffffff;
        font-weight: bold;
        border-radius: 8px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4);
        transition: background 0.3s ease;
      }

      .btn:hover {
        background: linear-gradient(90deg, #15803d, #16a34a);
      }

      .muted {
        color: #64748b;
        font-size: 13px;
      }

      hr {
        border: none;
        border-top: 1px solid #e2e8f0;
        margin: 20px 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h2>Password Reset Request</h2>
        <p>Hi <%= name || "there" %>,</p>
        <p>You (or someone else) requested to reset your password. This link will expire in <%= expiryMinutes %> minutes.</p>
        <p><a class="btn" href="<%= resetLink %>">Reset Password</a></p>
        <p class="muted">Or paste this link into your browser:<br/><a href="<%= resetLink %>"><%= resetLink %></a></p>
        <hr />
        <p class="muted">If you didn't request this, you can safely ignore this email.</p>
      </div>
    </div>
  </body>
</html>
