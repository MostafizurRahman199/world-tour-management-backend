<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Your OTP Code</title>
  <style>
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      background-color: #f0f4f8;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 40px auto;
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      padding: 0;
    }
    .header {
      background: linear-gradient(90deg, #4b6cb7, #182848);
      color: #fff;
      text-align: center;
      padding: 30px 20px;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
    }
    .body {
      padding: 30px 20px;
      text-align: center;
      color: #333;
    }
    .body p {
      font-size: 16px;
      margin: 10px 0;
    }
    .otp {
      display: inline-block;
      margin: 20px 0;
      font-size: 32px;
      font-weight: bold;
      color: #4b6cb7;
      padding: 15px 25px;
      border: 2px dashed #4b6cb7;
      border-radius: 8px;
      letter-spacing: 4px;
      background-color: #f0f4ff;
    }
    .button {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 25px;
      font-size: 16px;
      font-weight: bold;
      color: #fff;
      background-color: #4b6cb7;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.3s ease;
    }
    .button:hover {
      background-color: #182848;
    }
    .footer {
      background-color: #f9f9f9;
      text-align: center;
      font-size: 12px;
      color: #888;
      padding: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Your OTP Code</h1>
    </div>
    <div class="body">
      <p>Hello <%= name %>,</p>
      <p>Your One-Time Password (OTP) is:</p>
      <p class="otp"><%= otp %></p>
      <p>This OTP is valid for 5 minutes. Do not share it with anyone.</p>
      <a href="#" class="button">Verify OTP</a>
    </div>
    <div class="footer">
      <p>© <%= year %> Your Company Name. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
